APP_ENV=development
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cogni
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MIN=1440
# Production refuses LLM_PROVIDER=mock. Prefer OpenRouter (OpenAI-compatible):
#   LLM_PROVIDER=openai
#   LLM_MODEL=minimax/minimax-m3.1-flash:free
#   LLM_OCR_MODEL=nvidia/nemotron-3.5-super-vl:free
#   LLM_API_KEY=sk-or-v1-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
# Local/dev can use mock canned questions:
LLM_PROVIDER=mock
LLM_MODEL=minimax/minimax-m3.1-flash:free
LLM_OCR_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# heuristic (offline) or gptzero (needs GPTZERO_API_KEY; falls back to heuristic)
AI_DETECTOR=heuristic
GPTZERO_API_KEY=
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
MAX_REQUEST_MB=50
LOGIN_RATE_LIMIT_MAX=10
LLM_RATE_LIMIT_MAX=20
PUBLIC_BASE_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFY_MINUTES=60
LOGIN_LOCKOUT_FAILURES=8
LOGIN_LOCKOUT_MINUTES=10
# Required in production for password-reset and signup verification emails:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
