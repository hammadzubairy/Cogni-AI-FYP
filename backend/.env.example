APP_ENV=development
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cogni
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MIN=1440
# Production refuses LLM_PROVIDER=mock. Prefer Groq (OpenAI-compatible):
#   LLM_PROVIDER=openai
#   LLM_MODEL=qwen/qwen3.8-27b
#   LLM_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
# Local/dev can use mock canned questions:
LLM_PROVIDER=mock
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
AI_DETECTOR=heuristic
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=25
MAX_REQUEST_MB=50
LOGIN_RATE_LIMIT_MAX=10
LLM_RATE_LIMIT_MAX=20
PUBLIC_BASE_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFY_MINUTES=60
LOGIN_LOCKOUT_FAILURES=8
LOGIN_LOCKOUT_MINUTES=10
# Required in production for password-reset and signup verification emails:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
